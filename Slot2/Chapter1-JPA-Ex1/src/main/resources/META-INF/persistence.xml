<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="chapter1-jpa-ex1" transaction-type="RESOURCE_LOCAL">

        <!-- Entity được đăng ký -->
        <class>fu.de190259.entity.Employee</class>

        <properties>
            <!-- MSSQL Connection — đổi server/database/user/password cho đúng môi trường -->
            <property name="jakarta.persistence.jdbc.driver"
                      value="com.microsoft.sqlserver.jdbc.SQLServerDriver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:sqlserver://localhost:1435;databaseName=HSF302_JPA;encrypt=false;trustServerCertificate=true"/>
            <property name="jakarta.persistence.jdbc.user"     value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value="sa"/>

            <!-- Hibernate dialect -->
            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.SQLServerDialect"/>

            <!-- Tự tạo/cập nhật schema -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>

            <!-- Hiện SQL sinh ra để quan sát -->
            <property name="hibernate.show_sql"     value="true"/>
            <property name="hibernate.format_sql"   value="true"/>
        </properties>

    </persistence-unit>

</persistence>
